# ============================================================
# sky-take-out 环境变量模板
# 保存为 .env 并填入真实值
# ============================================================
# 仅在 Docker Compose 部署时需要
# 本地开发在 Nacos 配置中心配置对应的 sky-*-dev.yaml，将里面的 PLACEHOLDER 替换为真实值

# --- 数据库 ---
SKY_DB_PASSWORD=123456

# --- Redis ---
SKY_REDIS_PASSWORD=123456

# --- Nacos ---
# 认证已开启 (NACOS_AUTH_ENABLE=true)。首次部署需用此口令初始化管理员:
#   curl -X POST 'http://localhost:8848/nacos/v1/auth/users/admin' -d 'password=SkyNacos@2026'
NACOS_USERNAME=nacos
NACOS_PASSWORD=SkyNacos@2026

# --- JWT ---
SKY_JWT_ADMIN_SECRET=itcast
SKY_JWT_USER_SECRET=itbast

# --- 阿里云 OSS （需在阿里云控制台轮换并填入新值）---
SKY_ALIOSS_ENDPOINT=<your-oss-endpoint>
SKY_ALIOSS_AK=<your-access-key-id>
SKY_ALIOSS_SK=<your-access-key-secret>
SKY_ALIOSS_BUCKET=<your-bucket-name>

# --- 微信小程序 ---
SKY_WECHAT_APPID=<your-wechat-appid>
SKY_WECHAT_SECRET=<your-wechat-secret>

# --- 百度地图 ---
SKY_BAIDU_AK=<your-baidu-ak>

# --- 店铺 ---
SKY_SHOP_ADDRESS=<your-address>